# Server Configuration
PORT=3000
ENV=development
DEBUG=false
LOG_LEVEL=INFO

# Database Configuration (in-memory mock active in standalone runtime)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/launchgraph

# Security & Cryptography
SECRET_KEY=insecure-development-secret-key-change-in-production-min-32-chars

# Webhook Verification Secrets
GITHUB_WEBHOOK_SECRET=test-github-secret
GITHUB_TOKEN=
GITHUB_REPO=jashinspires/LaunchGraph
SLACK_SIGNING_SECRET=test-slack-secret
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
JIRA_WEBHOOK_SECRET=test-jira-secret
JIRA_API_TOKEN=
JIRA_EMAIL=
JIRA_DOMAIN=launchgraph.atlassian.net

# Decisioner Settings
JUDGMENT_BACKEND=deterministic
MODEL_NAME=claude-opus-5
K_SAMPLES=3
MAX_EVIDENCE_TOKENS=12000
ANTHROPIC_API_KEY=
